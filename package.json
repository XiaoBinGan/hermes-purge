{
  "name": "hermes-purge",
  "version": "2.0.0",
  "description": "Hermes Agent 破甲：能力层（capability）引擎 —— AST / shim / 文本 / 配置四层落地，事务回滚 + 三级验证 + 观测。跨 macOS / Windows。",
  "license": "MIT",
  "author": "XiaoBinGan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoBinGan/hermes-purge.git"
  },
  "bugs": {
    "url": "https://github.com/XiaoBinGan/hermes-purge/issues"
  },
  "homepage": "https://github.com/XiaoBinGan/hermes-purge#readme",
  "keywords": [
    "hermes",
    "hermes-agent",
    "patch",
    "approval",
    "jailbreak",
    "redteam"
  ],
  "bin": {
    "hermes-purge": "./bin/hermes-purge.js",
    "hp": "./bin/hp.js",
    "purge": "./bin/purge.js"
  },
  "main": "./lib/core.js",
  "files": [
    "bin/",
    "lib/",
    "test/",
    "payload/SOUL.md",
    "payload/prefill_messages.json",
    "hp.cmd",
    "purge.cmd",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "status": "node bin/hermes-purge.js --status",
    "apply": "node bin/hermes-purge.js --apply",
    "verify": "node bin/hermes-purge.js --verify",
    "revert": "node bin/hermes-purge.js --revert",
    "test": "node test/smoke.js && node test/v2.js",
    "test:package": "node test/package.js",
    "v2": "node bin/purge.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ]
}
