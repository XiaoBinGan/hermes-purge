{
  "name": "hermes-purge",
  "version": "3.0.3",
  "description": "宿主无关的能力层（capability）引擎 —— adapter 注册表 + AST/shim/文本/配置 四层落地，内置 Hermes Agent 与 DeepSeek Harness 两个 adapter；事务回滚 + 三级验证 + 观测。跨 macOS / Windows。",
  "license": "MIT",
  "author": "XiaoBinGan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoBinGan/hermes-purge.git"
  },
  "bugs": {
    "url": "https://github.com/XiaoBinGan/hermes-purge/issues"
  },
  "homepage": "https://github.com/XiaoBinGan/hermes-purge#readme",
  "keywords": [
    "hermes",
    "hermes-agent",
    "deepseek-harness",
    "dsh",
    "adapter",
    "capability",
    "patch",
    "approval",
    "jailbreak",
    "redteam"
  ],
  "bin": {
    "hermes-purge": "./bin/hermes-purge.js",
    "hp": "./bin/hp.js",
    "purge": "./bin/purge.js"
  },
  "main": "./lib/core.js",
  "files": [
    "bin/",
    "lib/",
    "adapters/",
    "test/dsh-fixture.js",
    "test/dsh.js",
    "payload/SOUL.md",
    "payload/prefill_messages.json",
    "hp.cmd",
    "purge.cmd",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/",
    "install.sh",
    "install.ps1",
    "bench/",
    "windows-smoke.ps1"
  ],
  "scripts": {
    "status": "node bin/hermes-purge.js --status",
    "apply": "node bin/hermes-purge.js --apply",
    "verify": "node bin/hermes-purge.js --verify",
    "revert": "node bin/hermes-purge.js --revert",
    "test": "node test/smoke.js && node test/v2.js && node test/dsh.js && node test/setup.js && node test/bench.js && node test/plugin.js && node test/control.js && node test/desktop.js && node test/desktop-dom.js",
    "test:package": "node test/package.js",
    "test:dsh": "node test/dsh.js",
    "v2": "node bin/purge.js",
    "v2:dsh": "node bin/purge.js status --adapter=dsh",
    "test:setup": "node test/setup.js",
    "test:bench": "node test/bench.js",
    "judge": "node bench/judge-eval.js",
    "test:plugin": "node test/plugin.js",
    "test:desktop": "node test/desktop.js",
    "test:control": "node test/control.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ]
}
